# Security headers for Cloudflare Pages (static export)
# NOTE: static export cannot do per-request nonces, so 'unsafe-inline'
# is required for the Next.js bootstrap/theme scripts and framer-motion
# inline styles. Everything else is locked down below.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; font-src 'self' data:; connect-src 'self' https: wss:; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

# Cache static assets (immutable chunks)
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Cache videos (bundled default loops are immutable)
/videos/*
  Cache-Control: public, max-age=31536000, immutable

# Cache images
/*.png
  Cache-Control: public, max-age=86400
/*.jpg
  Cache-Control: public, max-age=86400
/*.jpeg
  Cache-Control: public, max-age=86400
/*.svg
  Cache-Control: public, max-age=86400
/*.webp
  Cache-Control: public, max-age=86400
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.woff
  Cache-Control: public, max-age=31536000, immutable

# Cache manifest
/manifest.json
  Cache-Control: public, max-age=86400

# Don't cache HTML
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Cache service worker
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
